# Copy this file to .env and fill in your values
# Do NOT commit .env to git

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your bot's application/client ID
CLIENT_ID=your_client_id_here

# Your Discord server (guild) ID
GUILD_ID=your_guild_id_here

# Postgres connection string (e.g. from Railway's Postgres plugin)
DATABASE_URL=postgres://user:password@host:port/dbname

# Free API key from https://www.football-data.org
FOOTBALL_API_KEY=your_football_data_api_key_here

# Any secret string you pick — protects the /admin dashboard
ADMIN_API_KEY=your_admin_api_key_here

# Port the admin dashboard/API listens on (optional, defaults to 3000)
API_PORT=3000
